{
  "name": "tasin-cloud-os",
  "private": true,
  "version": "2.1.0",
  "description": "Interactive DevOps, cloud engineering and AI research portfolio for Alam Md Tasin.",
  "author": "Alam Md Tasin",
  "homepage": "https://my-new-portfolio-iota-two.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tasin007/My_Portfolio_V1.1.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names WEB,API --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server.mjs",
    "start": "node server.mjs",
    "build": "vite build",
    "vercel-build": "vite build",
    "preview": "npm run build && node server.mjs",
    "preview:vite": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  }
}
